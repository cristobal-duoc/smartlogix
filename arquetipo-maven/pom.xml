<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ARQUETIPO MAVEN — SmartLogix
    Este POM define la estructura base compartida por todos los microservicios.
    ms-inventario y ms-pedidos fueron generados usando esta estructura como plantilla.

    Un arquetipo Maven es una plantilla de proyecto reutilizable que define:
    - Dependencias comunes a todos los microservicios
    - Estructura de paquetes estándar (controller/service/repository/entity)
    - Configuración del plugin de Spring Boot

    Para crear un nuevo microservicio basado en este arquetipo:
    1. Copiar esta carpeta
    2. Cambiar groupId, artifactId y name en el pom.xml
    3. Renombrar los paquetes de com.smartlogix.arquetipo a com.smartlogix.{nombre}
    4. Implementar la lógica específica en cada capa
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.smartlogix</groupId>
  <artifactId>arquetipo-maven</artifactId>
  <version>1.0.0</version>
  <name>arquetipo-maven</name>
  <description>Plantilla base para microservicios SmartLogix</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- API REST: expone los endpoints HTTP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JPA: mapeo objeto-relacional con Hibernate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Driver PostgreSQL: conexión a la base de datos -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Testing: JUnit 5 + Mockito -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Empaqueta la aplicación como JAR ejecutable -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
