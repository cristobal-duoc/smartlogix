# Directorio de compilacion de Maven (clases, JARs, recursos procesados).
# NUNCA se commitea: es codigo generado, pesa mucho y varia entre maquinas.
target/

# Configuracion local con credenciales reales (nunca al repositorio).
application-local.properties
application-*.properties
!application.properties
!application-example.properties

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
